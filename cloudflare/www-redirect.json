{
  "ref": "disco_media_www_to_apex",
  "description": "Disco Media www to apex without an application runtime",
  "expression": "http.host eq \"www.discomedia.co\"",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "target_url": {
        "expression": "concat(\"https://discomedia.co\", http.request.uri.path)"
      },
      "status_code": 301,
      "preserve_query_string": true
    }
  },
  "enabled": true
}
