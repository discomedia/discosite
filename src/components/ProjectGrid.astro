---
import type { Project } from "../data/projects";
type Props = { projects: Project[] };
const { projects } = Astro.props;
---

<div class="project-grid">
  {projects.map((project, index) => (
    <a
      class="project-card"
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${project.name} — visit ${project.format.toLowerCase()} (opens in a new tab)`}
    >
      <div
        class:list={[
          "project-screen",
          { "phone-screen": project.slug === "absolute-timer" },
        ]}
        style={`--card-color: ${project.color}`}
      >
        <div class="browser-frame">
          <div class="browser-toolbar" aria-hidden="true">
            <span class="browser-dots">● ● ●</span>
            <span>{new URL(project.url).hostname}</span>
            <span>↗</span>
          </div>
          <img
            src={`/images/projects/${project.slug}.webp`}
            alt={`Screenshot of ${project.name}`}
            width={project.slug === "absolute-timer" ? 460 : 1200}
            height={project.slug === "absolute-timer" ? 1000 : 833}
            loading="lazy"
            decoding="async"
          />
        </div>
        <span class="project-format">{project.format}</span>
      </div>
      <div class="project-meta">
        <span class="eyebrow">{project.category}</span>
        <span class="project-number">{String(index + 1).padStart(2, "0")}</span>
      </div>
      <div class="project-title">
        <h3>{project.name}</h3>
        <span class="project-arrow" aria-hidden="true">
          ↗
        </span>
      </div>
      <p>{project.description}</p>
    </a>
  ))}
</div>
