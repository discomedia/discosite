---
import "../styles.css";
import { BrandMark } from "./BrandMark";
import type { PageRecord } from "../lib/types";

type Props = {
  title: string;
  description: string;
  path: string;
  pages: PageRecord[];
};

const { title, description, path, pages } = Astro.props;
const navPages = pages.filter((page) => page.published).sort((a, b) => a.order - b.order);
const canonical = new URL(path === "/" ? "/" : path, Astro.site ?? "https://discomedia.co").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content="Disco Media" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/92 backdrop-blur">
      <div class="content-shell flex min-h-20 items-center justify-between gap-8">
        <a class="focus-ring" href="/" aria-label="Disco Media home">
          <BrandMark />
        </a>
        <nav class="hidden items-center gap-2 md:flex" aria-label="Primary navigation">
          {
            navPages.map((page) => (
              <a
                class:list={[
                  "focus-ring px-4 py-7 text-sm font-bold transition",
                  page.slug === path ? "text-slate-950 shadow-[inset_0_-3px_0_#0891b2]" : "text-slate-600 hover:text-slate-950",
                ]}
                href={page.slug}
              >
                {page.navLabel}
              </a>
            ))
          }
          <a
            class:list={[
              "focus-ring px-4 py-7 text-sm font-bold transition",
              path === "/admin" ? "text-slate-950 shadow-[inset_0_-3px_0_#0891b2]" : "text-slate-600 hover:text-slate-950",
            ]}
            href="/admin"
          >
            Admin
          </a>
          <a class="focus-ring ml-3 bg-blue-700 px-6 py-3 text-sm font-bold text-white transition hover:bg-blue-800" href="/contact">
            Contact
          </a>
        </nav>
        <details class="relative md:hidden">
          <summary class="focus-ring list-none border border-slate-300 px-3 py-2 text-sm font-bold text-slate-700">
            Menu
          </summary>
          <div class="absolute right-0 top-12 grid w-48 gap-1 border border-slate-200 bg-white p-2 shadow-xl">
            {navPages.map((page) => <a class="px-3 py-2 text-sm font-bold text-slate-700" href={page.slug}>{page.navLabel}</a>)}
            <a class="px-3 py-2 text-sm font-bold text-slate-700" href="/admin">Admin</a>
          </div>
        </details>
      </div>
    </header>

    <div class="site-main">
      <slot />
    </div>

    <footer class="border-t border-slate-800 bg-slate-950 text-white">
      <div class="content-shell flex flex-col gap-8 py-10 md:flex-row md:items-center md:justify-between">
        <BrandMark invert />
        <div class="flex flex-col gap-3 text-sm text-slate-300 md:flex-row md:items-center md:gap-7">
          <span>Based in Melbourne, Australia</span>
          <span class="hidden h-5 w-px bg-slate-700 md:block"></span>
          <span>ACN 647498691</span>
        </div>
        <nav class="flex flex-wrap gap-5 text-sm font-bold text-slate-300" aria-label="Footer navigation">
          <a class="hover:text-white" href="/contact">Contact</a>
          <a class="hover:text-white" href="/support">Support</a>
          <a class="hover:text-white" href="/privacy">Privacy</a>
          <a class="hover:text-white" href="/admin">Admin</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
