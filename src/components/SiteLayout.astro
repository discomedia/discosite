---
import "../styles.css";
import { BrandMark } from "./BrandMark";
import { FooterMenu, HeaderMenu } from "./SiteNavigation";
import { seedMenuItems } from "../lib/content";
import type { PageRecord } from "../lib/types";

type Props = {
  title: string;
  description: string;
  path: string;
  pages: PageRecord[];
};

const { title, description, path, pages } = Astro.props;
const fallbackMenuItems = seedMenuItems(pages);
const canonical = new URL(path === "/" ? "/" : path, Astro.site ?? "https://discomedia.co").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content="Disco Media" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/92 backdrop-blur">
      <div class="content-shell flex min-h-20 items-center justify-between gap-8">
        <a class="focus-ring" href="/" aria-label="Disco Media home">
          <BrandMark />
        </a>
        <HeaderMenu currentPath={path} fallbackItems={fallbackMenuItems} client:load />
      </div>
    </header>

    <div class="site-main">
      <slot />
    </div>

    <footer class="border-t border-slate-800 bg-slate-950 text-white">
      <div class="content-shell flex flex-col gap-8 py-10 md:flex-row md:items-center md:justify-between">
        <BrandMark invert />
        <div class="flex flex-col gap-3 text-sm text-slate-300 md:flex-row md:items-center md:gap-7">
          <span>Based in Melbourne, Australia</span>
          <span class="hidden h-5 w-px bg-slate-700 md:block"></span>
          <span>ACN 647498691</span>
        </div>
        <FooterMenu currentPath={path} fallbackItems={fallbackMenuItems} client:load />
      </div>
    </footer>
  </body>
</html>
