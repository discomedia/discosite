---
import "../styles.css";
import BrandMark from "./BrandMark.astro";
type Props = { title: string; description: string; path: string };
const { title, description, path } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
const navigation = [
  { href: "/", label: "Home" },
  { href: "/portfolio/", label: "Portfolio" },
  { href: "/contact/", label: "Contact" },
];
const isCurrent = (href: string) => path === href || (href === "/portfolio/" && path.startsWith("/projects/"));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content="Disco Media" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://discomedia.co/images/social-card.png"
    />
    <meta property="og:image:width" content="1481" />
    <meta property="og:image:height" content="778" />
    <meta property="og:image:alt" content="Disco Media: Publishing and Apps for Everyday Life, based in Melbourne / Naarm, Australia." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fafaf7" />
    {import.meta.env.PROD && <>
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-PKNRGD305Q"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-PKNRGD305Q");
    </script>
    </>}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand-link" href="/" aria-label="Disco Media home">
          <BrandMark />
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          {navigation.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? (path === item.href ? "page" : "location") : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <details class="mobile-menu">
          <summary>
            Menu
          </summary>
          <nav aria-label="Mobile navigation">
            {navigation.map((item) => (
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? (path === item.href ? "page" : "location") : undefined}
              >
                {item.label}
              </a>
            ))}
            <a href="/support/">Support</a>
          </nav>
        </details>
      </div>
    </header>
    <div class="site-main">
      <slot />
    </div>
    <footer class="site-footer">
      <div class="shell">
        <div class="footer-top">
          <a href="/" aria-label="Disco Media home">
            <BrandMark />
          </a>
          <p>
            Independent media & software.
            <br />Melbourne / Naarm, Australia.
          </p>
          <a class="text-link" href="mailto:info@discomedia.co">
            info@discomedia.co
          </a>
        </div>
        <div class="footer-bottom">
          <span>
            © {new Date().getFullYear()} Disco Media · ACN 647 498 691
          </span>
          <nav aria-label="Footer navigation">
            <a href="/support/">Support</a>
            <a href="/privacy/">Privacy</a>
            <a href="/terms/">Terms</a>
          </nav>
        </div>
      </div>
    </footer>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");
      menu?.addEventListener("keydown", event => {
        if (event.key === "Escape") {
          menu.open = false;
          menu.querySelector("summary")?.focus();
        }
      });
      document.addEventListener("click", event => {
        if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
      });
    </script>
  </body>
</html>
