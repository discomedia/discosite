---
import SiteLayout from "../components/SiteLayout.astro";
---

<SiteLayout
  title="Page not found | Disco Media"
  description="This page could not be found. Explore Disco Media’s projects or get in touch."
  path="/404/"
>
  <main id="main" class="shell contact-page">
    <p class="eyebrow">Error 404</p>
    <h1>Page not found</h1>
    <p class="intro">
      This address doesn’t match a page on our site. You can find our publications,
      apps and tools in the portfolio.
    </p>
    <a class="button" href="/portfolio/">
      View our projects
    </a>
  </main>
</SiteLayout>
