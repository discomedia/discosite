---
import SiteLayout from "../../components/SiteLayout.astro";
---

<SiteLayout
  title="Contact | Disco Media"
  description="Contact Disco Media for partnerships, questions, and general enquiries."
  path="/contact/"
>
  <main id="main" class="shell contact-page">
    <p class="eyebrow">Disco Media · Melbourne / Naarm, Australia</p>
    <h1>Contact us</h1>
    <div class="contact-grid">
      <p class="intro">
        For partnership proposals and questions about our publications or apps,
        email us with the project name and what you’d like to discuss.
      </p>
      <div class="contact-panel">
        <span class="eyebrow">General enquiries & partnerships</span>
        <a class="email-link" href="mailto:info@discomedia.co">
          info@discomedia.co
        </a>
        <hr />
        <p>
          Need help with one of our products?{" "}
          <a class="text-link" href="/support/">
            Get product support
          </a>
        </p>
      </div>
    </div>
  </main>
</SiteLayout>
