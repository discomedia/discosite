---
import SiteLayout from "../../components/SiteLayout.astro";
---

<SiteLayout
  title="Say hello | Disco Media"
  description="Contact Disco Media for partnerships, questions, and general enquiries."
  path="/contact/"
>
  <main id="main" class="shell contact-page">
    <p class="eyebrow">Get in touch</p>
    <h1>
      Good things start
      <br />
      with a hello<span class="accent-dot">.</span>
    </h1>
    <div class="contact-grid">
      <p class="intro">
        A partnership idea, a question, or something you think we should build?
        We’d love to hear it.
      </p>
      <div class="contact-panel">
        <span class="eyebrow">General enquiries & partnerships</span>
        <a class="email-link" href="mailto:info@discomedia.co">
          info@discomedia.co <span aria-hidden="true">↗</span>
        </a>
        <p>
          Send us an email and our Melbourne-based team will get back to you.
        </p>
        <hr />
        <p>
          Need help with one of our products?{" "}
          <a class="text-link" href="/support/">
            Visit support ↗
          </a>
        </p>
      </div>
    </div>
  </main>
</SiteLayout>
