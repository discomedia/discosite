---
import SiteLayout from "../components/SiteLayout.astro";
import { PageRenderer } from "../components/PageRenderer";
import { findSeedPage, publicSeedPages } from "../lib/content";

const page = findSeedPage("/")!;
const pages = publicSeedPages();
---

<SiteLayout title={page.seoTitle} description={page.description} path="/" pages={pages}>
  <PageRenderer page={page} mode="home" client:load />
</SiteLayout>
