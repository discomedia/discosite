---
import SiteLayout from "../../components/SiteLayout.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import ProjectFilter from "../../components/ProjectFilter.astro";
import ContactBanner from "../../components/ContactBanner.astro";
import { projects } from "../../data/projects";
---

<SiteLayout
  title="Portfolio | Disco Media"
  description="Explore Disco Media’s websites, apps, and tools for travel, languages, motorcycles, research, and more."
  path="/portfolio/"
>
  <main id="main">
    <section class="shell portfolio-intro">
      <div>
        <p class="eyebrow">The Disco Media portfolio</p>
        <h1>
          Our Portfolio<span class="accent-dot">.</span>
        </h1>
      </div>
      <div>
        <p class="intro">
          Here are our projects, spanning our interests but unified by a common
          theme of bringing people together and making the world a smaller place.
        </p>
        <span class="portfolio-count">
          {String(projects.length).padStart(2, "0")} projects / Keep exploring ↓
        </span>
      </div>
    </section>
    <section class="shell portfolio-work" aria-label="Projects">
      <ProjectFilter projects={projects} />
      <div id="portfolio-projects"><ProjectGrid projects={projects} /></div>
    </section>
    <ContactBanner />
  </main>
</SiteLayout>
