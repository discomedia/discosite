---
import SiteLayout from "../../components/SiteLayout.astro";
import { projects } from "../../data/projects";
import AppScreenshots from "../../components/AppScreenshots.astro";
export function getStaticPaths() {
  return projects.filter(project => project.overview).map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---

<SiteLayout title={`${project.name} | Disco Media`} description={project.description} path={`/projects/${project.slug}/`}>
  <main id="main" class="shell project-detail">
    <div>
      <a class="text-link" href="/portfolio/">All projects</a>
      <p class="eyebrow">{project.category} / {project.format}</p>
      <h1>{project.name}</h1>
      <p class="intro">{project.description}</p>
      <p class="project-overview">{project.overview}</p>
      <a class="button" href={`mailto:info@discomedia.co?subject=${encodeURIComponent(project.name)}`}>Email us about {project.name}</a>
    </div>
    <div class="project-detail-image">
      {project.screenshots ? <AppScreenshots screenshots={project.screenshots} /> : <img src={`/images/projects/${project.slug}.webp`} alt={`Screenshot of the ${project.name} iPhone app`} width={project.imageWidth} height={project.imageHeight} />}
    </div>
  </main>
</SiteLayout>
