---
import SiteLayout from "../../components/SiteLayout.astro";
---

<SiteLayout
  title="Support | Disco Media"
  description="Get help with Disco Media products, apps, and websites."
  path="/support/"
>
  <main id="main" class="shell contact-page">
    <p class="eyebrow">Disco Media</p>
    <h1>Product support</h1>
    <div class="contact-grid">
      <div>
        <p class="intro">
          Email us if you’re having trouble with one of our apps or websites.
        </p>
        <p class="muted">
          Include the product name, what you were trying to do, what happened
          and your device or browser. If there’s an error message, include its
          text or a screenshot so we can investigate.
        </p>
      </div>
      <div class="contact-panel">
        <span class="eyebrow">Product support</span>
        <a class="email-link" href="mailto:support@discomedia.co">
          support@discomedia.co
        </a>
        <hr />
        <p>
          For anything else,{" "}
          <a class="text-link" href="/contact/">
            contact us
          </a>
        </p>
      </div>
    </div>
  </main>
</SiteLayout>
