---
import SiteLayout from "../../components/SiteLayout.astro";
---

<SiteLayout
  title="Support | Disco Media"
  description="Get help with Disco Media products, apps, and websites."
  path="/support/"
>
  <main id="main" class="shell contact-page">
    <p class="eyebrow">We’re here to help</p>
    <h1>
      A little help.
      <br />
      Back on track<span class="accent-dot">.</span>
    </h1>
    <div class="contact-grid">
      <div>
        <p class="intro">
          Something not working as it should? Let us know and we’ll help you get
          it sorted.
        </p>
        <p class="muted">
          Please include the product name, what happened, and the device or
          browser you’re using. A screenshot can help, too.
        </p>
      </div>
      <div class="contact-panel">
        <span class="eyebrow">Product support</span>
        <a class="email-link" href="mailto:support@discomedia.co">
          support@discomedia.co <span aria-hidden="true">↗</span>
        </a>
        <p>
          You can email us directly from your preferred email app, or copy the
          address above.
        </p>
        <hr />
        <p>
          For anything else,{" "}
          <a class="text-link" href="/contact/">
            say hello ↗
          </a>
        </p>
      </div>
    </div>
  </main>
</SiteLayout>
