---
import SiteLayout from "../../components/SiteLayout.astro";
import { PageRenderer } from "../../components/PageRenderer";
import { findSeedPage, publicSeedPages } from "../../lib/content";

const page = findSeedPage("/terms")!;
const pages = publicSeedPages();
---

<SiteLayout title={page.seoTitle} description={page.description} path="/terms" pages={pages}>
  <PageRenderer page={page} client:load />
</SiteLayout>
